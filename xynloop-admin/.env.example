PORT=3000
# production = tolak jalan tanpa SESSION_SECRET
NODE_ENV=development

# Secret untuk tanda tangan sesi. Ganti dengan string acak panjang di produksi.
SESSION_SECRET=ganti-dengan-string-acak-64-karakter

# Lama sesi login bertahan (hari)
SESSION_DAYS=30

# Path relatif terhadap folder aplikasi
DATA_DIR=data
UPLOAD_DIR=uploads

# Buat akun pemilik awal bila basis data masih kosong.
# Password ini wajib diganti saat login pertama (sistem memaksa penggantian).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ganti-dengan-password-sementara
